---
import Layout from '../../../../layouts/Layout.astro';
const { usuario } = Astro.locals;
import NavBar from '@/components/layout/NavBar';
import SideBar from '@/components/layout/SideBar';
import ProduccionReporteServilleta from '@/components/Reportes/BobinaServilleta/Produccion';
---

<Layout>
	<div class="md:hidden">
		<NavBar client:media="(max-width: 767.98px)" idRol={usuario.IdRol} seccion="reportes" />
	</div>
	<div class="hidden md:block">
		<SideBar client:media="(min-width: 768px)" idRol={usuario.IdRol} seccion="reportes" />
	</div>
	<ProduccionReporteServilleta client:load usuario={usuario} />
</Layout>
