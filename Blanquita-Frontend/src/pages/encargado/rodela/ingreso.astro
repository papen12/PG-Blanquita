---
import Layout from '../../../layouts/Layout.astro';
const { usuario } = Astro.locals;
import NavBar from '@/components/layout/NavBar';
import SideBar from '@/components/layout/SideBar';
import IngresoRodelas from '@/components/Rodela/Ingreso';
import BottomBar from '@/components/layout/Qr/BottomBar';
---

<Layout>
	<div class="md:hidden">
		<NavBar client:media="(max-width: 767.98px)" idRol={usuario.IdRol} />
	</div>
	<div class="hidden md:block">
		<SideBar client:media="(min-width: 768px)" idRol={usuario.IdRol} />
	</div>
	<IngresoRodelas client:load usuario={usuario}/>
	<BottomBar idRol={usuario.IdRol} subRuta={"rodela"} idOpcionSelect={2} client:load/>
</Layout>
