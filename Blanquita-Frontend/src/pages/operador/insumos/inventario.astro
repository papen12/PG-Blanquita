---
import Layout from '../../../layouts/Layout.astro';
import InventarioInsumos from '@/components/Insumo/InventarioInsumos';
const { usuario } = Astro.locals;
import NavBar from '@/components/layout/NavBar';
import SideBar from '@/components/layout/SideBar';
import BottomBar from '@/components/layout/Qr/BottomBar';
---

<Layout>
	<div class="md:hidden">
		<NavBar client:media="(max-width: 767.98px)" idRol={usuario.IdRol} esAdmin={usuario.IsAdmin} />
	</div>
	<div class="hidden md:block">
		<SideBar client:media="(min-width: 768px)" idRol={usuario.IdRol} esAdmin={usuario.IsAdmin} />
	</div>
	<InventarioInsumos client:load />
	<BottomBar idRol={usuario.IdRol} subRuta={""} idOpcionSelect={4} client:load/>
</Layout>
