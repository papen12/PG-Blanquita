---
import Layout from '../../../layouts/Layout.astro';
import ProduccionRodela from '@/components/Rodela/produccion';
const { usuario } = Astro.locals;
import NavBar from '@/components/layout/NavBar';
import BottomBar from '@/components/layout/Qr/BottomBar';
---

<Layout>
	<NavBar client:load idRol={usuario.IdRol} />
	<ProduccionRodela client:load usuario={usuario}/>
	<BottomBar idRol={usuario.IdRol} subRuta={"rodela"} idOpcionSelect={1} client:load/>
</Layout>
