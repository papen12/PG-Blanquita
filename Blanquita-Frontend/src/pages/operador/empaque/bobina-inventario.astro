---
import Layout from '../../../layouts/Layout.astro';
import EmpaqueBobinaInventario from '@/components/Empaque/EmpaqueBobinaInventario'
const { usuario } = Astro.locals;
import NavBar from '@/components/layout/NavBar';
import BottomBar from '@/components/layout/Qr/BottomBar';
---

<Layout>
	<NavBar client:load idRol={usuario.IdRol} />
	<EmpaqueBobinaInventario client:load usuario={usuario}/>
	<BottomBar idRol={usuario.IdRol} subRuta={"empaque"} idOpcionSelect={2} client:load/>
</Layout>
