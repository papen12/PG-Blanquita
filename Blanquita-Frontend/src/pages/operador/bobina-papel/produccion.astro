---
import Layout from '../../../layouts/Layout.astro';
import ProduccionBobinaTubo from '@/components/PapelBobina/Produccion/ProduccionPapelBobina';
const { usuario } = Astro.locals;
import NavBar from '@/components/layout/NavBar';
import BottomBar from '@/components/layout/Qr/BottomBar';
---

<Layout>
	<NavBar client:load idRol={usuario.IdRol} />
	<ProduccionBobinaTubo client:load usuario={usuario}/>
	<BottomBar idRol={usuario.IdRol} subRuta={"bobina-papel"} client:load/>
</Layout>
