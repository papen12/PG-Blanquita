---
import Layout from '../../../layouts/Layout.astro';
import InventarioBobinasPapel from '../../../components/PapelBobina/Inventario/InventarioOperador';
const { usuario } = Astro.locals;
import NavBar from '@/components/layout/NavBar';
import BottomBar from '@/components/layout/BottomBar';
---

<Layout>
	<NavBar client:load idRol={usuario.IdRol} />
	<InventarioBobinasPapel client:load usuario={usuario}/>
	<BottomBar idRol={usuario.IdRol} subRuta={"bobina-papel"} client:load/>
</Layout>
