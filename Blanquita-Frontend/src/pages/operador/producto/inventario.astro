---
import Layout from '../../../layouts/Layout.astro';
const { usuario } = Astro.locals;
import NavBar from '@/components/layout/NavBar';
import SideBar from '@/components/layout/SideBar';
import BottomBar from '@/components/layout/Qr/BottomBar';
import InventarioProductoTerminado from '@/components/InventarioProductos/InventarioProductos';
---

<Layout>
	<div class="md:hidden">
		<NavBar client:media="(max-width: 767.98px)" idRol={usuario.IdRol} />
	</div>
	<div class="hidden md:block">
		<SideBar client:media="(min-width: 768px)" idRol={usuario.IdRol} />
	</div>
	<InventarioProductoTerminado client:load usuario={usuario}/>
	<!--DEFINIR LUEGO PARA USAR LAS RUTAS <BottomBar idRol={usuario.IdRol} subRuta={"producto"} client:load/> -->
</Layout>
