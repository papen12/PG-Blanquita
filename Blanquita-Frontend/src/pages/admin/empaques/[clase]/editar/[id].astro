---
import Layout from '../../../../../layouts/Layout.astro';
const { usuario } = Astro.locals;
const { clase } = Astro.params;
if (!['bobina', 'bolsa', 'jaba'].includes(clase)) return Astro.redirect('/admin/empaques');
const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect(`/admin/empaques?clase=${clase}`);
import NavBar from '@/components/layout/NavBar';
import SideBar from '@/components/layout/SideBar';
import { FormularioTipoEmpaque } from '@/components/Admin/Empaques/TiposEmpaque';
---

<Layout>
	<div class="md:hidden">
		<NavBar client:media="(max-width: 767.98px)" idRol={usuario.IdRol} esAdmin={usuario.IsAdmin} seccion="admin" />
	</div>
	<div class="hidden md:block">
		<SideBar client:media="(min-width: 768px)" idRol={usuario.IdRol} esAdmin={usuario.IsAdmin} seccion="admin" />
	</div>
	<FormularioTipoEmpaque client:load clase={clase} id={id} />
</Layout>
