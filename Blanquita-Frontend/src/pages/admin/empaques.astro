---
import Layout from '../../layouts/Layout.astro';
const { usuario } = Astro.locals;
const claseInicial = Astro.url.searchParams.get('clase') ?? 'bobina';
import NavBar from '@/components/layout/NavBar';
import SideBar from '@/components/layout/SideBar';
import TiposEmpaque from '@/components/Admin/Empaques/TiposEmpaque';
---

<Layout>
	<div class="md:hidden">
		<NavBar client:media="(max-width: 767.98px)" idRol={usuario.IdRol} esAdmin={usuario.IsAdmin} seccion="admin" />
	</div>
	<div class="hidden md:block">
		<SideBar client:media="(min-width: 768px)" idRol={usuario.IdRol} esAdmin={usuario.IsAdmin} seccion="admin" />
	</div>
	<TiposEmpaque client:load claseInicial={claseInicial} />
</Layout>
